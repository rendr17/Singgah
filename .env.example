# Client-safe variables only — PUBLIC_* values ship in the web bundle.
# Server/provider secrets belong to services/api env config.

PUBLIC_APP_ENV=development
PUBLIC_API_BASE_URL=http://localhost:8080
# Basemap default: Protomaps hosted API (style v5/light). Key is required —
# restrict it per domain in the Protomaps account portal (localhost exempt).
PUBLIC_PROTOMAPS_API_KEY=
# Optional full override for a self-hosted/custom MapLibre style URL.
PUBLIC_MAP_STYLE_URL=

# services/api (server-only)
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://singgah:singgah@localhost:5432/singgah?sslmode=disable
# singgah_test is created by the compose init script — migrate it before
# running DB integration tests (see database/README.md).
TEST_DATABASE_URL=postgres://singgah:singgah@localhost:5432/singgah_test?sslmode=disable
COMMUTE_BASE_URL=https://api.commute.shiorilabs.id
CORS_ORIGIN=*
