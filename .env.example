# Client-safe variables only — PUBLIC_* values ship in the web bundle.
# Server/provider secrets belong to services/api env config.

PUBLIC_APP_ENV=development
PUBLIC_API_BASE_URL=http://localhost:8080
PUBLIC_MAP_STYLE_URL=

# services/api (server-only)
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://singgah:singgah@localhost:5432/singgah?sslmode=disable
TEST_DATABASE_URL=postgres://singgah:singgah@localhost:5432/singgah_test?sslmode=disable
